---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { I18N, PAGES, SITE } from '../data/site';

interface Props {
  lang: 'it' | 'en';
  pageKey: string;
  title: string;
  description: string;
  schema?: string;
  ogImage?: string;
}

const { lang, pageKey, title, description, schema, ogImage = '/og.jpg' } =
  Astro.props;
const path = PAGES[pageKey][lang];
const canonical = SITE.url + path;
const alternateIt = SITE.url + PAGES[pageKey].it;
const alternateEn = SITE.url + PAGES[pageKey].en;
const alternateOther = lang === 'it' ? alternateEn : alternateIt;
const htmlLang = I18N[lang].langLabel;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="it" href={alternateIt} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateIt} />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={SITE.url + ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'it' ? 'en_US' : 'it_IT'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={SITE.url + ogImage} />

    <meta name="theme-color" content="#14382c" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {schema && <script type="application/ld+json" set:html={schema} />}
  </head>
  <body class="banner-shown">
    <a class="skip-link" href="#main">{lang === 'it' ? 'Vai al contenuto' : 'Skip to content'}</a>

    <!-- Top promo banner: hidden on scroll, closed with X, back on scroll-to-top -->
    <div
      id="top-banner"
      class="top-banner"
      role="region"
      aria-label={lang === 'it' ? 'Promozione' : 'Promotion'}
    >
      <p>
        {lang === 'it' ? (
          <>Prenota direttamente e risparmia il <strong>10%</strong> rispetto a Booking.</>
        ) : (
          <>Book directly and save <strong>10%</strong> compared to Booking.</>
        )}
      </p>
      <button
        id="top-banner-close"
        class="top-banner-close"
        aria-label={lang === 'it' ? 'Chiudi' : 'Close'}
        >&#10005;</button
      >
    </div>

    <Header lang={lang} pageKey={pageKey} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <!-- Lightbox (tap to zoom / de-zoom, dark backdrop) -->
    <div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Immagine ingrandita">
      <button id="lightbox-close" class="lightbox-close" aria-label="Chiudi">&#10005;</button>
      <img id="lightbox-img" src="" alt="" />
      <p class="lightbox-hint">
        {lang === 'it' ? 'Tocca l\u2019immagine per ingrandire o ridurre' : 'Tap the image to zoom in or out'}
      </p>
    </div>

    <WhatsAppButton />

    <script is:inline>
      (function () {
        var lb = document.getElementById('lightbox');
        var lbImg = document.getElementById('lightbox-img');
        var lbClose = document.getElementById('lightbox-close');
        var lbHint = document.querySelector('.lightbox-hint');

        function openLb(src, alt) {
          lbImg.src = src;
          lbImg.alt = alt || '';
          lbImg.classList.remove('is-zoomed');
          if (lbHint) lbHint.style.display = 'block';
          lb.classList.add('is-open');
          document.body.style.overflow = 'hidden';
        }
        function closeLb() {
          lb.classList.remove('is-open');
          document.body.style.overflow = '';
        }
        document.querySelectorAll('[data-lightbox]').forEach(function (img) {
          img.addEventListener('click', function () {
            openLb(img.currentSrc || img.src, img.alt);
          });
        });
        lbImg.addEventListener('click', function () {
          lbImg.classList.toggle('is-zoomed');
          if (lbHint) lbHint.style.display = lbImg.classList.contains('is-zoomed') ? 'none' : 'block';
        });
        lbClose.addEventListener('click', closeLb);
        lb.addEventListener('click', function (e) {
          if (e.target === lb) closeLb();
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') closeLb();
        });

        var toggle = document.getElementById('nav-toggle');
        var nav = document.getElementById('nav');
        if (toggle && nav) {
          toggle.addEventListener('click', function () {
            var open = nav.classList.toggle('is-open');
            toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          });
          nav.addEventListener('click', function (e) {
            if (e.target.closest('a')) {
              nav.classList.remove('is-open');
              toggle.setAttribute('aria-expanded', 'false');
            }
          });
        }

        // Top promo banner: hidden on scroll, closed with X, back on scroll-to-top.
        var banner = document.getElementById('top-banner');
        var bannerClose = document.getElementById('top-banner-close');
        if (banner && bannerClose) {
          var bannerClosed = false;
          function syncBanner() {
            if (bannerClosed) return;
            var h = banner.offsetHeight || 44;
            document.body.style.setProperty('--banner-h', h + 'px');
            var atTop = (window.scrollY || window.pageYOffset) < 12;
            banner.classList.toggle('is-hidden', !atTop);
            document.body.classList.toggle('banner-shown', atTop);
          }
          window.addEventListener('scroll', syncBanner, { passive: true });
          window.addEventListener('resize', syncBanner);
          window.addEventListener('load', syncBanner);
          // Re-measure once fonts are decoded (fallback->webfont can change
          // how many lines the text wraps to).
          setTimeout(syncBanner, 400);
          syncBanner();
          bannerClose.addEventListener('click', function () {
            bannerClosed = true;
            banner.classList.add('is-closed');
            document.body.classList.remove('banner-shown');
          });
        }
      })();
    </script>
  </body>
</html>
