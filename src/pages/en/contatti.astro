---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { SITE, PHOTO, PAGES } from '../../data/site';
import { lodgingSchema, breadcrumbSchema } from '../../data/schema';

const lang = 'en' as const;
const title = 'Contact B&B Milano Malpensa 1 \u00b7 Castano Primo';
const description =
  'Phone 339 294 6283, WhatsApp and address: Via Lonate Pozzolo 1, 20022 Castano Primo (MI). How to get here from Malpensa and Milan.';
const schema = [
  lodgingSchema(lang),
  breadcrumbSchema(lang, [
    { name: 'Home', key: 'home' },
    { name: 'Contact', key: 'contatti' },
  ]),
].join(',');
---
<Layout
  lang={lang}
  pageKey="contatti"
  title={title}
  description={description}
  schema={`[${schema}]`}
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg">
      <img src={PHOTO.struttura.src} alt={PHOTO.struttura.alt} width={PHOTO.struttura.w} height={PHOTO.struttura.h} fetchpriority="high" />
    </div>
    <div class="container hero-content">
      <span class="hero-kicker">Contact us</span>
      <h1>Contact and how to get here</h1>
      <p class="lead">
        Call us or write on WhatsApp: we answer in Italian and English, with
        availability, prices and directions in a few minutes.
      </p>
      <div class="btn-row">
        <a class="btn btn--accent" href={SITE.phoneHref}>Call: {SITE.phoneDisplay}</a>
        <a class="btn btn--ghost" href={SITE.whatsapp} target="_blank" rel="noopener">Write on WhatsApp</a>
      </div>
    </div>
  </section>

  <div class="container section">
    <Breadcrumbs items={[{ name: 'Contact', href: PAGES.contatti.en }]} />
  </div>

  <!-- Contact -->
  <section class="section" aria-labelledby="contatti-title">
    <div class="container">
      <div class="split">
        <div>
          <span class="eyebrow">Direct contacts</span>
          <h2 id="contatti-title">Let&rsquo;s talk on the phone</h2>
          <ul class="contact-list">
            <li>
              <Icon name="phone" />
              <span>
                Phone<br />
                <a href={SITE.phoneHref}>{SITE.phoneDisplay}</a>
              </span>
            </li>
            <li>
              <svg width="24" height="24" viewBox="0 0 32 32" fill="#2a7359" aria-hidden="true" style="margin-top:.2rem">
                <path d="M16.04 4C9.4 4 4 9.38 4 16c0 2.13.57 4.2 1.64 6.03L4 28l6.12-1.6A12.04 12.04 0 0 0 16.04 28C22.68 28 28 22.62 28 16S22.68 4 16.04 4zm0 21.92c-1.9 0-3.76-.52-5.37-1.49l-.39-.23-3.63.95.97-3.54-.25-.39A9.9 9.9 0 0 1 6.1 16c0-5.48 4.46-9.94 9.94-9.94S26 10.52 26 16s-4.46 9.92-9.96 9.92z" />
              </svg>
              <span>
                WhatsApp<br />
                <a href={SITE.whatsapp} target="_blank" rel="noopener">Write on WhatsApp</a>
              </span>
            </li>
            <li>
              <Icon name="pin" />
              <span>
                Address<br />
                <a href={SITE.mapsUrl} target="_blank" rel="noopener"
                  >{SITE.address.street}, {SITE.address.zip} {SITE.address.city} ({SITE.address.province})</a
                >
              </span>
            </li>
            <li>
              <Icon name="clock" />
              <span>
                Check-in<br />
                Flexible, to be agreed (also late in the evening)
              </span>
            </li>
          </ul>
        </div>
        <figure class="photo photo--portrait">
          <img src={PHOTO.cartellone.src} alt={PHOTO.cartellone.alt} width={PHOTO.cartellone.w} height={PHOTO.cartellone.h} loading="lazy" decoding="async" data-lightbox />
        </figure>
      </div>
    </div>
  </section>

  <!-- How to get here -->
  <section class="section section--tint" aria-labelledby="arrivare-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">How to get here</span>
        <h2 id="arrivare-title">Reach us in a few steps</h2>
      </div>
      <div class="grid grid--3">
        <div class="card">
          <span class="card-ico"><Icon name="plane" size={26} /></span>
          <h3>From Malpensa (15 km)</h3>
          <p>
            Shuttle on request: tell us the time and terminal and we will pick
            you up. Alternatively taxi, about 20 minutes.
          </p>
        </div>
        <div class="card">
          <span class="card-ico"><Icon name="train" size={26} /></span>
          <h3>From Milan by train</h3>
          <p>
            From Milan Cadorna, Saronno&ndash;Novara line: get off at Castano
            Primo and walk 5 minutes to the B&amp;B.
          </p>
        </div>
        <div class="card">
          <span class="card-ico"><Icon name="car" size={26} /></span>
          <h3>By car</h3>
          <p>
            Motorway A8 or A4, Marcallo-Mesero exit: free parking on site.
          </p>
        </div>
      </div>
      <p style="margin-top: var(--space-3)">
        <a class="btn btn--line" href={SITE.mapsUrl} target="_blank" rel="noopener"
          >Open the location in Google Maps</a
        >
      </p>
    </div>
  </section>

  <CtaBand
    title="We look forward to seeing you in Castano Primo"
    text="One call and everything is sorted: availability, shuttle, arrival times and any question you have."
  />
</Layout>
