---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Gallery from '../components/Gallery.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { SITE, PHOTO, PRICES, PAGES } from '../data/site';
import { lodgingSchema, websiteSchema, breadcrumbSchema } from '../data/schema';

const lang = 'it' as const;
const title = 'B&B Milano Malpensa 1 \u00b7 a Castano Primo, vicino a Milano';
const description =
  'B&B a Castano Primo, a 15 km da Malpensa e a 1h di treno da Milano: camere da \u20ac45 con bagno privato, Wi-Fi e parcheggio. Chiama 339 294 6283.';
const schema = [
  lodgingSchema(lang),
  websiteSchema(lang),
  breadcrumbSchema(lang, [{ name: 'Home', key: 'home' }]),
].join(',');
---
<Layout lang={lang} pageKey="home" title={title} description={description} schema={`[${schema}]`}>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg">
      <img src={PHOTO.struttura.src} alt={PHOTO.struttura.alt} width={PHOTO.struttura.w} height={PHOTO.struttura.h} fetchpriority="high" />
    </div>
    <div class="container hero-content">
      <span class="hero-kicker">Benvenuti al B&amp;B Milano Malpensa 1</span>
      <h1>B&amp;B a Castano Primo, tra Malpensa e Milano</h1>
      <p class="lead">
        Camere con bagno privato, Wi-Fi, parcheggio e navetta per
        l&rsquo;aeroporto: la base comoda ed economica per chi viaggia per
        lavoro tra Milano e Malpensa. Colazione inclusa, prezzi sempre visibili.
      </p>
      <div class="btn-row">
        <a class="btn btn--accent" href={SITE.phoneHref}>Chiama ora: {SITE.phoneDisplay}</a>
        <a class="btn btn--ghost" href={PAGES.lavoro.it}>Per chi viaggia per lavoro</a>
        <a class="btn btn--ghost" href={PAGES.camere.it}>Camere e prezzi</a>
      </div>
      <div class="hero-meta">
        <span><strong>15 km</strong> dall&rsquo;aeroporto</span>
        <span><strong>5 min</strong> a piedi dalla stazione per Milano</span>
        <span><strong>da &euro;45</strong> a notte, colazione inclusa</span>
        <span><strong>176</strong> recensioni su Google</span>
      </div>
    </div>
  </section>

  <!-- Why us -->
  <section class="section" aria-labelledby="perche-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Perch&eacute; sceglierci</span>
        <h2 id="perche-title">Un B&amp;B pensato per lavoro e viaggi</h2>
        <p class="lead">
          A Castano Primo, nel cuore dell&rsquo;Alto Milanese: comodi per le
          aziende della zona, per Milano e per l&rsquo;aeroporto di Malpensa.
        </p>
      </div>
      <div class="grid grid--2">
        <a class="card" href={PAGES.lavoro.it}>
          <span class="card-ico"><Icon name="car" size={26} /></span>
          <h3>Per lavoro e trasferte</h3>
          <p>
            Soggiorni anche settimanali, Wi-Fi veloce, colazione presto e
            parcheggio: la soluzione per tecnici, pendolari e aziende.
          </p>
        </a>
        <a class="card" href={PAGES.malpensa.it}>
          <span class="card-ico"><Icon name="plane" size={26} /></span>
          <h3>Navetta per Malpensa</h3>
          <p>
            Ritiro e accompagnamento in aeroporto su richiesta: perfetto per
            voli all&rsquo;alba, scali e rientri in tarda serata.
          </p>
        </a>
        <a class="card" href={PAGES.castano.it}>
          <span class="card-ico"><Icon name="train" size={26} /></span>
          <h3>Milano in treno</h3>
          <p>
            La stazione di Castano Primo &egrave; a 5 minuti a piedi: Milano
            Cadorna in circa un&rsquo;ora, senza auto e senza stress.
          </p>
        </a>
        <a class="card" href={PAGES.camere.it}>
          <span class="card-ico"><Icon name="home" size={26} /></span>
          <h3>Prezzi chiari e visibili</h3>
          <p>
            Da &euro;45 a notte con colazione inclusa: camere con bagno privato,
            TV e aria condizionata, senza sorprese.
          </p>
        </a>
      </div>
    </div>
  </section>

  <!-- Rooms + prices preview -->
  <section class="section section--tint" aria-labelledby="camere-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Camere e prezzi</span>
        <h2 id="camere-title">Camere semplici, pulite, al prezzo giusto</h2>
        <p class="lead">
          Ogni camera ha bagno privato, TV, Wi-Fi gratuito e aria
          condizionata. Prezzi indicativi a notte, colazione inclusa.
        </p>
      </div>
      <Gallery
        photos={[PHOTO.lettoMatrimoniale, PHOTO.castelloSingolo, PHOTO.quattroLetti, PHOTO.bagno5]}
        eagerFirst
      />
      <div class="facts" style="margin-top: var(--space-3)">
        <div class="fact"><strong>{PRICES.single.it}</strong><span>camera singola</span></div>
        <div class="fact"><strong>{PRICES.double.it}</strong><span>matrimoniale / doppia</span></div>
        <div class="fact"><strong>{PRICES.triple.it}</strong><span>tripla</span></div>
        <div class="fact"><strong>{PRICES.family.it}</strong><span>quadrupla famiglia</span></div>
      </div>
      <p class="price-note" style="margin-top: var(--space-2)">{PRICES.note.it}</p>
      <p style="margin-top: var(--space-3)">
        <a class="btn btn--line" href={PAGES.camere.it}>Scopri tutte le camere e i prezzi</a>
      </p>
    </div>
  </section>

  <!-- The area: work / Milano / Malpensa -->
  <section class="section" aria-labelledby="zona-title">
    <div class="container">
      <div class="split">
        <figure class="photo photo--wide">
          <img src={PHOTO.piazza.src} alt={PHOTO.piazza.alt} width={PHOTO.piazza.w} height={PHOTO.piazza.h} loading="lazy" decoding="async" data-lightbox />
        </figure>
        <div>
          <span class="eyebrow">La nostra zona</span>
          <h2 id="zona-title">Tra Milano, Malpensa e le aziende dell&rsquo;Alto Milanese</h2>
          <p>
            Castano Primo &egrave; il punto strategico per chi lavora tra
            Milano e l&rsquo;aeroporto di Malpensa: a 15 km dai terminal, con la
            stazione per Milano Cadorna a due passi e le principali arterie
            (A8, A4) vicine. Dopo il lavoro, la tranquillit&agrave; di un paese
            sul Ticino.
          </p>
          <ul class="checklist">
            <li><Icon name="check" /> Navetta per l&rsquo;aeroporto di Malpensa su richiesta</li>
            <li><Icon name="check" /> Stazione di Castano Primo a 5 minuti a piedi</li>
            <li><Icon name="check" /> Wi-Fi, parcheggio e check-in flessibile</li>
            <li><Icon name="check" /> Tariffe settimanali per chi lavora in zona</li>
          </ul>
          <p style="margin-top: var(--space-3)">
            <a class="btn btn--line" href={PAGES.contatti.it}>Come arrivare</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <Reviews lang={lang} />
  <CtaBand
    title="Cerchi un alloggio per lavoro o prima di un volo?"
    text="Chiamaci o scrivici su WhatsApp: ti confermiamo disponibilità, prezzo esatto e servizio navetta in pochi minuti."
  />
</Layout>
