---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Gallery from '../components/Gallery.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { SITE, PHOTO, PRICES, PAGES } from '../data/site';
import { lodgingSchema, breadcrumbSchema } from '../data/schema';

const lang = 'it' as const;
const title = 'Camere e prezzi B&B Milano Malpensa 1 \u00b7 Castano Primo';
const description =
  'Camere da \u20ac45 a notte con bagno privato, TV, Wi-Fi e aria condizionata: singole, doppie, triple e quadruple con letto a castello. Chiama 339 294 6283.';
const schema = [
  lodgingSchema(lang),
  breadcrumbSchema(lang, [
    { name: 'Home', key: 'home' },
    { name: 'Camere e prezzi', key: 'camere' },
  ]),
].join(',');
---
<Layout
  lang={lang}
  pageKey="camere"
  title={title}
  description={description}
  schema={`[${schema}]`}
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg">
      <img src={PHOTO.salotto.src} alt={PHOTO.salotto.alt} width={PHOTO.salotto.w} height={PHOTO.salotto.h} fetchpriority="high" />
    </div>
    <div class="container hero-content">
      <span class="hero-kicker">Le nostre camere</span>
      <h1>Camere e prezzi: semplici, pulite, convenienti</h1>
      <p class="lead">
        Tutte le camere hanno bagno privato, TV, Wi-Fi gratuito e aria
        condizionata. Prezzi sempre visibili, colazione inclusa, da
        &euro;45 a notte.
      </p>
      <div class="btn-row">
        <a class="btn btn--accent" href={SITE.phoneHref}>Chiama per disponibilit&agrave;</a>
        <a class="btn btn--ghost" href={PAGES.contatti.it}>Contatti e come arrivare</a>
      </div>
    </div>
  </section>

  <div class="container section">
    <Breadcrumbs items={[{ name: 'Camere e prezzi', href: PAGES.camere.it }]} />
  </div>

  <!-- Price summary -->
  <section class="section" aria-labelledby="tariffe-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Le tariffe</span>
        <h2 id="tariffe-title">Quanto costa dormire qui</h2>
        <p class="lead">{PRICES.note.it}</p>
      </div>
      <div class="facts">
        <div class="fact"><strong>{PRICES.single.it}</strong><span>singola</span></div>
        <div class="fact"><strong>{PRICES.double.it}</strong><span>matrimoniale</span></div>
        <div class="fact"><strong>{PRICES.twin.it}</strong><span>doppia letti singoli</span></div>
        <div class="fact"><strong>{PRICES.triple.it}</strong><span>tripla</span></div>
      </div>
      <div class="facts">
        <div class="fact"><strong>{PRICES.family.it}</strong><span>quadrupla famiglia</span></div>
        <div class="fact"><strong>{PRICES.group.it}</strong><span>letto a castello</span></div>
        <div class="fact"><strong>7+ notti</strong><span>{PRICES.weekly.it}</span></div>
      </div>
    </div>
  </section>

  <!-- Room types with photos below -->
  <section class="section section--tint" aria-labelledby="tipologie-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Le tipologie</span>
        <h2 id="tipologie-title">Quale camera fa per te?</h2>
        <p class="lead">
          Ogni camera &egrave; arredata in modo semplice ma curato, con
          biancheria, asciugamani e tutto il necessario per il tuo soggiorno.
        </p>
      </div>

      <div class="room">
        <div class="room-card">
          <h3>Camera singola</h3>
          <p>Per chi viaggia da solo, in trasferta o per una notte prima del volo.</p>
          <span class="price">{PRICES.single.it} <small>/ notte, colazione inclusa</small></span>
        </div>
        <div class="room-photos">
          <Gallery photos={[PHOTO.lettoSingoli]} />
        </div>
      </div>

      <div class="room">
        <div class="room-card">
          <h3>Camera matrimoniale</h3>
          <p>Letto matrimoniale comodo e camera spaziosa: l&rsquo;ideale per le coppie.</p>
          <span class="price">{PRICES.double.it} <small>/ notte, colazione inclusa</small></span>
        </div>
        <div class="room-photos">
          <Gallery photos={[PHOTO.lettoMatrimoniale, PHOTO.lettoMatrimoniale3]} />
        </div>
      </div>

      <div class="room">
        <div class="room-card">
          <h3>Camera doppia con letti singoli</h3>
          <p>Due letti separati: perfetta per colleghi di lavoro o amici in viaggio.</p>
          <span class="price">{PRICES.twin.it} <small>/ notte, colazione inclusa</small></span>
        </div>
        <div class="room-photos">
          <Gallery photos={[PHOTO.dueLettiSingoli, PHOTO.lettoSingoli]} />
        </div>
      </div>

      <div class="room">
        <div class="room-card">
          <h3>Camera tripla</h3>
          <p>Matrimoniale e letto singolo: la soluzione per piccole famiglie.</p>
          <span class="price">{PRICES.triple.it} <small>/ notte, colazione inclusa</small></span>
        </div>
        <div class="room-photos">
          <Gallery photos={[PHOTO.matrimonialeSingolo]} />
        </div>
      </div>

      <div class="room">
        <div class="room-card">
          <h3>Camera famiglia o gruppo</h3>
          <p>
            Fino a 4-6 posti: matrimoniale, letti singoli e letto a castello
            per famiglie, comitive e gruppi di lavoro.
          </p>
          <span class="price">{PRICES.family.it} <small>/ notte, colazione inclusa</small></span>
          <span class="price-note">In alternativa, {PRICES.group.it} nella zona castello.</span>
        </div>
        <div class="room-photos">
          <Gallery
            photos={[
              PHOTO.castelloSingolo,
              PHOTO.castello2,
              PHOTO.quattroLetti,
              PHOTO.lettoCastello,
              PHOTO.castelloBasso,
            ]}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Bathrooms -->
  <section class="section" aria-labelledby="bagni-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">I bagni privati</span>
        <h2 id="bagni-title">Bagno privato in ogni camera</h2>
        <p class="lead">
          Niente bagni in comune: ogni camera ha il suo, con doccia e
          sanitari.
        </p>
      </div>
      <Gallery photos={[PHOTO.bagno5, PHOTO.bagno3, PHOTO.bagno7, PHOTO.bagno9]} />
    </div>
  </section>

  <!-- Services -->
  <section class="section section--tint" aria-labelledby="servizi-title">
    <div class="container">
      <div class="split">
        <div>
          <span class="eyebrow">I servizi inclusi</span>
          <h2 id="servizi-title">Tutto quello che serve, senza sorprese</h2>
          <ul class="checklist">
            <li><Icon name="check" /> Colazione: caff&egrave;, croissant e dolci</li>
            <li><Icon name="check" /> Wi-Fi gratuito in tutta la struttura</li>
            <li><Icon name="check" /> Aria condizionata</li>
            <li><Icon name="check" /> TV in camera</li>
            <li><Icon name="check" /> Parcheggio in struttura</li>
            <li><Icon name="check" /> Animali ammessi (da concordare)</li>
            <li><Icon name="check" /> Navetta per Malpensa su richiesta</li>
            <li><Icon name="check" /> Tariffe settimanali per lavoro</li>
          </ul>
        </div>
        <figure class="photo photo--portrait">
          <img src={PHOTO.colazione.src} alt={PHOTO.colazione.alt} width={PHOTO.colazione.w} height={PHOTO.colazione.h} loading="lazy" decoding="async" data-lightbox />
        </figure>
      </div>
    </div>
  </section>

  <CtaBand
    title="Trovi la camera giusta per il tuo viaggio?"
    text="Chiamaci o scrivici su WhatsApp: ti confermiamo disponibilit\u00e0, prezzo esatto e servizi in pochi minuti."
  />
</Layout>
