---
interface Props {
  items: { name: string; href?: string }[];
}
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Briciole di pane">
  <a href="/">Home</a>
  {items.map((it, i) => (
    <>
      <span aria-hidden="true">/</span>
      {it.href ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}
    </>
  ))}
</nav>
