---
import Logo from './Logo.astro';
import { NAV, SITE } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <Logo />
      <span class="brand-name">
        B&amp;B Milano Malpensa 1
        <span class="brand-sub">Bed &amp; Breakfast &middot; Castano Primo</span>
      </span>
    </a>

    <button
      id="nav-toggle"
      class="nav-toggle"
      aria-label="Apri il menu"
      aria-expanded="false"
      aria-controls="nav"
      ><span></span><span></span><span></span></button
    >

    <nav class="nav" id="nav" aria-label="Menu principale">
      {
        NAV.map((item) => (
          <a
            class="nav-link"
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            >{item.label}</a
          >
        ))
      }
    </nav>

    <a class="btn btn--primary btn--sm header-cta" href={SITE.phoneHref}
      ><svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
        ><path
          d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"
        /></svg
      >Chiama ora</a
    >
  </div>
</header>
