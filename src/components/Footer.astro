---
import Logo from './Logo.astro';
import { I18N, PAGES, SITE } from '../data/site';

interface Props {
  lang: 'it' | 'en';
}
const { lang } = Astro.props;
const t = I18N[lang];
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <a class="brand" href={PAGES.home[lang]} style="text-decoration: none">
          <Logo />
          <span class="brand-name" style="color: #fff"
            >{t.brandName}<span class="brand-sub">{t.brandSub}</span></span
          >
        </a>
        <p style="margin-top: 1rem; max-width: 30rem">{t.footer.about}</p>
      </div>
      <div class="footer-col">
        <p class="footer-title">{t.footer.sitemapTitle}</p>
        <ul>
          {t.nav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="footer-col">
        <p class="footer-title">{t.footer.contactTitle}</p>
        <ul>
          <li>
            <a href={SITE.phoneHref}>Tel. {SITE.phoneDisplay}</a>
          </li>
          <li><a href={SITE.whatsapp} rel="noopener" target="_blank">WhatsApp</a></li>
          <li>
            <a href={SITE.mapsUrl} rel="noopener" target="_blank"
              >{SITE.address.street}, {SITE.address.zip} {SITE.address.city} ({SITE.address.province})</a
            >
          </li>
          <li>
            <a href={SITE.bookingUrl} rel="noopener" target="_blank"
              >{t.footer.book}</a
            >
          </li>
        </ul>
      </div>
    </div>
    <div class="footer-note">
      <span>&copy; {new Date().getFullYear()} {SITE.name} &middot; {t.footer.note} &middot; {SITE.address.city} ({SITE.address.province})</span>
      <span
        ><a href="/sitemap-index.xml">{t.footer.sitemap}</a> &middot; <a href="/robots.txt">{t.footer.robots}</a> &middot;
        <a href={SITE.tripadvisorUrl} rel="noopener" target="_blank">{t.footer.reviews}</a></span
      >
    </div>
  </div>
</footer>
