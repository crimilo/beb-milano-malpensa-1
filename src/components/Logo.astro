---
// Logo mark: minimal "M" monogram (Milano · Malpensa · letto) with an
// amber take-off swoosh (aeroporto). Decorative inside links.
interface Props {
  class?: string;
}
const { class: className = 'brand-mark' } = Astro.props;
---
<svg
  class={className}
  viewBox="0 0 64 64"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  ><rect width="64" height="64" rx="18" fill="#14382c" /><g
    stroke="#fbf7f0"
    stroke-width="5.5"
    stroke-linecap="round"
    fill="none"
    ><path d="M21 24v16" /><path d="M32 24v16" /><path d="M43 24v16" /><path d="M16.5 40h31" /></g
  ><path
    d="M37 12.5q10-5 17-.5"
    stroke="#e9a23b"
    stroke-width="4"
    stroke-linecap="round"
    fill="none"
  /></svg
>
